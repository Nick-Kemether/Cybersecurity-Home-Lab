<!--
  Custom Wazuh Detection Rules
  Author: Nick Kemether
  
  These rules were developed based on attack simulations run in the home lab.
  Each rule maps to a MITRE ATT&CK technique.
-->

<!-- T1110.001 - Brute Force: Password Guessing -->
<!-- Note: Wazuh rule 5760 detects SSH brute force out of the box.
     The following is an example of how a custom tuned rule would look
     to reduce false positives in a specific environment -->

<group name="custom_brute_force,">
  <rule id="100001" level="10">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force attempt from same source IP - T1110.001</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,brute_force</group>
  </rule>
</group>

<!-- T1046 - Network Service Scanning -->
<!-- Triggered by Suricata integration when nmap scans are detected -->
<group name="custom_network_scan,">
  <rule id="100002" level="8">
    <if_sid>86601</if_sid>
    <match>ET SCAN</match>
    <description>Network scan detected via Suricata - T1046</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>network_scan,recon</group>
  </rule>
</group>
